# Copy to .env and fill in. .env is gitignored and must never be committed.

# Flask session signing key. Any long random value.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Email, used only for the password-reset flow.
# For Gmail this must be an App Password, not the account password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional. Defaults to sqlite:///trimq_franchise.db when unset.
# SQLite is the only backend this app has been run against.
DATABASE_URL=
